<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/principal" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp">
<com.google.android.material.button.MaterialButton android:id="@+id/botao_voltar" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/voltar" />
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/titulo_historico" android:textSize="28sp" android:textStyle="bold" android:textColor="?attr/colorOnSurface" android:layout_marginTop="16dp" />
<TextView android:id="@+id/estado_historico" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/carregando_livros" android:textSize="16sp" android:textColor="?attr/colorOnSurfaceVariant" android:layout_marginTop="16dp" android:accessibilityLiveRegion="polite" />
<LinearLayout android:id="@+id/lista_historico" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
