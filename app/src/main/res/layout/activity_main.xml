<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
 android:id="@+id/principal" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:background="?attr/colorSurface">
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp">
 <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/app_name" android:textSize="28sp" android:textColor="?attr/colorOnSurface" android:layout_marginTop="16dp" android:textStyle="bold" />
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp" android:layout_marginTop="24dp" android:background="@drawable/background_intro">
 <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/welcome" android:textSize="32sp" android:textColor="#FFFFFF" android:layout_marginTop="16dp" android:fontFamily="serif" />
 <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/intro" android:textSize="16sp" android:textColor="#E1EAE5" android:layout_marginTop="16dp"  />
 </LinearLayout>
 <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
     android:text="@string/titulo_luminosidade" android:textSize="24sp" android:textStyle="bold"
     android:layout_marginTop="24dp" android:textColor="?attr/colorOnSurface" />
 <TextView android:id="@+id/origem_luminosidade" android:layout_width="match_parent"
     android:layout_height="wrap_content" android:layout_marginTop="8dp"
     android:textSize="16sp" android:textColor="?attr/colorOnSurfaceVariant" />
 <com.example.projetofinal.view.MedidorLuminosidade android:id="@+id/medidor_luminosidade"
     android:layout_width="match_parent" android:layout_height="160dp" android:layout_marginTop="16dp" />
 <TextView android:id="@+id/leitura_luminosidade" android:layout_width="match_parent"
     android:layout_height="wrap_content" android:textSize="20sp"
     android:text="@string/medidor_aguardando" android:textColor="?attr/colorOnSurface" />
 <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
     android:text="@string/legenda_medidor" android:textSize="14sp"
     android:layout_marginTop="8dp" android:textColor="?attr/colorOnSurfaceVariant" />
 <com.google.android.material.checkbox.MaterialCheckBox android:id="@+id/modo_manual"
     android:layout_width="match_parent" android:layout_height="wrap_content"
     android:saveEnabled="false" android:text="@string/modo_manual" />
 <SeekBar android:id="@+id/controle_luminosidade" android:layout_width="match_parent"
     android:layout_height="48dp" android:max="1000" android:progress="200"
     android:saveEnabled="false" android:visibility="gone"
     android:contentDescription="@string/controle_luz_descricao" />
 <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/light" android:textSize="22sp" android:textColor="?attr/colorOnSurface" android:layout_marginTop="16dp" android:textStyle="bold" /><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/light_description" android:textSize="16sp" android:textColor="?attr/colorOnSurfaceVariant" android:layout_marginTop="16dp"  />
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/medium" android:textSize="22sp" android:textColor="?attr/colorOnSurface" android:layout_marginTop="16dp" android:textStyle="bold" /><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/medium_description" android:textSize="16sp" android:textColor="?attr/colorOnSurfaceVariant" android:layout_marginTop="16dp"  />
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/dark" android:textSize="22sp" android:textColor="?attr/colorOnSurface" android:layout_marginTop="16dp" android:textStyle="bold" /><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/dark_description" android:textSize="16sp" android:textColor="?attr/colorOnSurfaceVariant" android:layout_marginTop="16dp"  />
 <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/coming_soon" android:textSize="14sp" android:textColor="?attr/colorOnSurfaceVariant" android:layout_marginTop="16dp"  />
 <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
     android:layout_marginTop="24dp" android:text="@string/catalog_title"
     android:textSize="24sp" android:textStyle="bold" android:textColor="?attr/colorOnSurface" />
 <com.google.android.material.checkbox.MaterialCheckBox android:id="@+id/filtro_clima"
     android:layout_width="match_parent" android:layout_height="wrap_content"
     android:saveEnabled="false" android:checked="true" android:text="@string/filtro_clima" />
 <com.google.android.material.checkbox.MaterialCheckBox android:id="@+id/filtro_favoritos" android:saveEnabled="false"
     android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/somente_favoritos" />
 <TextView android:id="@+id/estado_catalogo" android:layout_width="match_parent"
     android:layout_height="wrap_content" android:text="@string/carregando_livros"
     android:accessibilityLiveRegion="polite" android:textColor="?attr/colorOnSurface" />
 <LinearLayout android:id="@+id/lista_livros" android:layout_width="match_parent"
     android:layout_height="wrap_content" android:orientation="vertical" />
 </LinearLayout>
</androidx.core.widget.NestedScrollView>
