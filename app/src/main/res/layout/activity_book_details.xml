<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
 android:id="@+id/principal" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp">
 <com.google.android.material.button.MaterialButton android:id="@+id/botao_voltar" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/voltar" style="@style/Widget.Material3.Button.TextButton" />
 <ImageView android:id="@+id/capa_livro" android:layout_width="176dp" android:layout_height="252dp" android:layout_gravity="center_horizontal" android:layout_marginTop="16dp" android:layout_marginBottom="24dp" android:scaleType="fitCenter" android:background="@drawable/fundo_capa" android:src="@drawable/icone_livro" android:importantForAccessibility="no"/>
 <TextView android:id="@+id/clima_livro" android:layout_width="match_parent" android:layout_height="wrap_content"  android:textSize="14sp" android:textColor="?attr/colorOnSurface" android:gravity="center" android:alpha="0.7"/>
 <TextView android:id="@+id/titulo_livro" android:layout_width="match_parent" android:layout_height="wrap_content"  android:textSize="30sp" android:textColor="?attr/colorOnSurface" android:fontFamily="serif" android:gravity="center" android:layout_marginTop="8dp"/>
 <TextView android:id="@+id/autor_livro" android:layout_width="match_parent" android:layout_height="wrap_content"  android:textSize="16sp" android:textColor="?attr/colorOnSurface" android:gravity="center" android:layout_marginTop="8dp" android:alpha="0.7"/>
 <com.google.android.material.button.MaterialButton android:id="@+id/botao_favorito" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:minHeight="52dp" android:enabled="false" android:text="@string/carregando_livros"/>
 <com.google.android.material.button.MaterialButton android:id="@+id/botao_registrar" android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/Widget.Material3.Button.OutlinedButton" android:minHeight="52dp" android:enabled="false" android:text="@string/registrar_historico"/>
 <TextView  android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/synopsis" android:textSize="22sp" android:textColor="?attr/colorOnSurface" android:textStyle="bold" android:layout_marginTop="24dp"/>
 <TextView android:id="@+id/sinopse_livro" android:layout_width="match_parent" android:layout_height="wrap_content"  android:textSize="17sp" android:textColor="?attr/colorOnSurface" android:lineSpacingExtra="4dp" android:layout_marginTop="12dp"/>
 <TextView  android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/fonte_capas" android:textSize="12sp" android:textColor="?attr/colorOnSurface" android:layout_marginTop="24dp" android:alpha="0.65"/>
 </LinearLayout>
</androidx.core.widget.NestedScrollView>
