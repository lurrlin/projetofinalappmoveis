<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/principal" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
        <com.google.android.material.button.MaterialButton android:id="@+id/botao_voltar" style="@style/Widget.Material3.Button.TextButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/voltar"/>
        <com.example.projetofinal.view.CapaLivroView android:id="@+id/capa_livro" android:layout_width="152dp" android:layout_height="220dp" android:layout_gravity="center_horizontal" android:layout_marginTop="8dp" android:layout_marginBottom="20dp" android:importantForAccessibility="no"/>
        <TextView android:id="@+id/clima_livro" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:textSize="12sp" android:textColor="?attr/colorPrimary" android:tag="realce"/>
        <TextView android:id="@+id/titulo_livro" style="@style/Texto.Titulo" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:layout_marginTop="8dp" android:textSize="24sp"/>
        <TextView android:id="@+id/autor_livro" style="@style/Texto.Secundario" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:layout_marginTop="6dp"/>
        <com.google.android.material.button.MaterialButton android:id="@+id/botao_favorito" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:minHeight="52dp" android:enabled="false" android:text="@string/carregando_livros"/>
        <com.google.android.material.button.MaterialButton android:id="@+id/botao_registrar" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="52dp" android:enabled="false" android:text="@string/registrar_historico"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/synopsis" android:textSize="18sp" android:fontFamily="sans-serif-medium" android:textColor="?attr/colorOnSurface" android:layout_marginTop="24dp"/>
        <TextView android:id="@+id/sinopse_livro" style="@style/Texto.Secundario" android:layout_width="match_parent" android:layout_height="wrap_content" android:lineSpacingExtra="5dp" android:layout_marginTop="10dp"/>
        <com.google.android.material.button.MaterialButton android:id="@+id/botao_fonte" style="@style/Widget.Material3.Button.TextButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/ver_open_library" android:visibility="gone"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/fonte_capas" android:textSize="12sp" android:textColor="?attr/colorOnSurfaceVariant" android:layout_marginTop="12dp"/>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
